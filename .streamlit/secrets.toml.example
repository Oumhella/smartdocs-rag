[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-value"

[auth.clerk]
client_id = "your-clerk-oauth-client-id"
client_secret = "your-clerk-oauth-client-secret"
server_metadata_url = "https://your-clerk-instance.clerk.accounts.dev/.well-known/oauth-authorization-server"
client_kwargs = { "prompt" = "login" }
