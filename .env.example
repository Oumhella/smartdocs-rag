# Required to answer questions. Replace with your key; never commit .env.
GROQ_API_KEY=your-groq-api-key
# Groq model used for RAG answer generation.
GROQ_MODEL=openai/gpt-oss-20b
# Minimum cosine similarity accepted by the RAG pipeline.
RAG_MIN_SIMILARITY=0.15
# Shared server-to-server key for Streamlit to authenticate to FastAPI.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SMARTDOCS_INTERNAL_AUTH_TOKEN=replace-with-a-long-random-value
